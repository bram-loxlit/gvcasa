{% comment %}
  GV CASA — Collage Staggered Section (Preset A, staggered like reference)
{% endcomment %}

<section id="gvc-collage-{{ section.id }}" class="gvc-collage" style="--gvc-bg: {{ section.settings.bg | default: 'transparent' }};">
  <div class="gvc-collage-inner page-width">
    {%- if section.settings.heading != blank -%}
      <header class="gvc-collage-header">
        <h2 class="gvc-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="gvc-subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="gvc-grid">
      {%- for block in section.blocks -%}
        {%- assign span_c = block.settings.span_columns | default: 1 -%}
        {%- assign span_r = block.settings.span_rows | default: 1 -%}
        {%- assign ratio = block.settings.aspect | default: 'auto' -%}
        <div class="gvc-item gvc-{{ ratio }}" style="grid-column: span {{ span_c }}; grid-row: span {{ span_r }};" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a class="gvc-frame" href="{{ block.settings.link }}">{%- else -%}<div class="gvc-frame">{%- endif -%}
            {%- if block.settings.image != blank -%}
              {%- assign img = block.settings.image -%}
              {%- assign alt_txt = block.settings.alt | default: img.alt | default: '' -%}
              <picture>
                {%- if img.width >= 1200 -%}<source media="(min-width: 990px)" srcset="{{ img | img_url: '1200x' }} 1x, {{ img | img_url: '2400x' }} 2x">{%- endif -%}
                {%- if img.width >= 750 -%}<source media="(min-width: 750px)" srcset="{{ img | img_url: '900x' }} 1x, {{ img | img_url: '1800x' }} 2x">{%- endif -%}
                <img src="{{ img | img_url: '750x' }}" srcset="{{ img | img_url: '750x' }} 1x, {{ img | img_url: '1500x' }} 2x" alt="{{ alt_txt | escape }}" loading="lazy" width="{{ img.width }}" height="{{ img.height }}">
              </picture>
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
            {%- if block.settings.caption != blank -%}<figcaption class="gvc-cap">{{ block.settings.caption }}</figcaption>{%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <style>
    #gvc-collage-{{ section.id }}{
      --cols-d: {{ section.settings.columns_desktop | default: 3 }};
      --cols-t: {{ section.settings.columns_tablet | default: 2 }};
      --cols-m: {{ section.settings.columns_mobile | default: 1 }};
      --gap: {{ section.settings.gap }};
      --pad-y: {{ section.settings.pad_y }};
      --radius: {{ section.settings.radius }};
      background: var(--gvc-bg);
      padding: var(--pad-y) 0;
    }
    #gvc-collage-{{ section.id }} .gvc-collage-inner{ max-width: {% if section.settings.max_width == 'page' %}var(--page-width, 1200px){% else %}{{ section.settings.max_width_custom }}{% endif %}; margin: 0 auto; }
    #gvc-collage-{{ section.id }} .gvc-collage-header{ margin-bottom: 1.5rem; text-align: {{ section.settings.heading_align }}; }
    #gvc-collage-{{ section.id }} .gvc-title{ font-size: clamp(1.25rem, 1.2rem + 1vw, 2rem); line-height: 1.2; margin: 0; }
    #gvc-collage-{{ section.id }} .gvc-subtitle{ margin: .5rem 0 0 0; opacity: .8; }

    #gvc-collage-{{ section.id }} .gvc-grid{ display: grid; grid-template-columns: repeat(var(--cols-m), 1fr); gap: var(--gap); }
    @media (min-width: 750px){ #gvc-collage-{{ section.id }} .gvc-grid{ grid-template-columns: repeat(var(--cols-t), 1fr); } }
    @media (min-width: 990px){ #gvc-collage-{{ section.id }} .gvc-grid{ grid-template-columns: repeat(var(--cols-d), 1fr); } }

    #gvc-collage-{{ section.id }} .gvc-item{ position: relative; }
    #gvc-collage-{{ section.id }} .gvc-frame{ display: block; position: relative; overflow: hidden; border-radius: var(--radius); text-decoration: none; }
    #gvc-collage-{{ section.id }} .gvc-square .gvc-frame{ aspect-ratio: 1 / 1; }
    #gvc-collage-{{ section.id }} .gvc-portrait .gvc-frame{ aspect-ratio: 3 / 4; }
    #gvc-collage-{{ section.id }} .gvc-landscape .gvc-frame{ aspect-ratio: 4 / 3; }
    #gvc-collage-{{ section.id }} .gvc-auto .gvc-frame{ aspect-ratio: auto; }
    #gvc-collage-{{ section.id }} img{ width: 100%; height: 100%; object-fit: cover; display: block; }
    #gvc-collage-{{ section.id }} .gvc-cap{ font-size: .9rem; line-height: 1.35; margin-top: .5rem; }
  </style>
</section>

{% schema %}
{
  "name": "Collage, staggered grid",
  "tag": "section",
  "class": "section gvc-collage-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Default heading" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Default subheading" },
    { "type": "select", "id": "heading_align", "label": "Heading alignment", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ] },
    { "type": "select", "id": "max_width", "label": "Content width", "default": "page",
      "options": [ { "value": "page", "label": "Theme page width" }, { "value": "custom", "label": "Custom max width" } ] },
    { "type": "text", "id": "max_width_custom", "label": "Custom max width value", "info": "e.g. 1400px or 90rem", "default": "1400px" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FAF8EE" },
    { "type": "select", "id": "gap", "label": "Gap", "default": "28px",
      "options": [ { "value": "16px", "label": "Tight" }, { "value": "24px", "label": "Regular" }, { "value": "28px", "label": "Roomy" }, { "value": "36px", "label": "Spacious" } ] },
    { "type": "select", "id": "pad_y", "label": "Vertical padding", "default": "48px",
      "options": [ { "value": "0", "label": "None" }, { "value": "24px", "label": "Tight" }, { "value": "48px", "label": "Regular" }, { "value": "72px", "label": "Generous" } ] },
    { "type": "select", "id": "radius", "label": "Corner radius", "default": "0",
      "options": [ { "value": "0", "label": "Square" }, { "value": "8px", "label": "Subtle" }, { "value": "16px", "label": "Soft" }, { "value": "24px", "label": "Rounded" } ] },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Columns on desktop", "default": 3 },
    { "type": "range", "id": "columns_tablet", "min": 1, "max": 3, "step": 1, "label": "Columns on tablet", "default": 2 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 3, "step": 1, "label": "Columns on mobile", "default": 1 }
  ],
  "blocks": [
    { "type": "image", "name": "Image", "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Alt text" },
        { "type": "url", "id": "link", "label": "Link (optional)" },
        { "type": "text", "id": "caption", "label": "Caption (optional)", "default": "Caption" },
        { "type": "select", "id": "aspect", "label": "Aspect", "default": "auto",
          "options": [ { "value": "auto", "label": "Auto" }, { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" } ] },
        { "type": "range", "id": "span_columns", "label": "Span columns", "min": 1, "max": 3, "step": 1, "default": 1 },
        { "type": "range", "id": "span_rows", "label": "Span rows", "min": 1, "max": 3, "step": 1, "default": 1 }
      ] }
  ],
  "presets": [
    {
      "name": "Collage preset A (staggered)",
      "settings": { "heading": "Default heading", "subheading": "Default subheading", "bg": "#FAF8EE", "gap": "28px", "columns_desktop": 3 },
      "blocks": [
        { "type": "image", "settings": { "span_columns": 2, "span_rows": 2 } },
        { "type": "image", "settings": { "span_columns": 1, "span_rows": 1 } },
        { "type": "image", "settings": { "span_columns": 3, "span_rows": 1 } },
        { "type": "image", "settings": { "span_columns": 1, "span_rows": 1 } },
        { "type": "image", "settings": { "span_columns": 2, "span_rows": 2 } },
        { "type": "image", "settings": { "span_columns": 1, "span_rows": 1 } }
      ]
    }
  ]
}
{% endschema %}
