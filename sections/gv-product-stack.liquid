{% schema %}
{
  "name": "GV Parallax Stack",
  "settings": [
    {
      "type": "header",
      "content": "Sectie Instellingen"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "vh",
      "label": "Totale Hoogte Sectie",
      "default": 200,
      "info": "Hoe hoger dit getal, hoe meer ruimte de foto's hebben om te bewegen."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Achtergrondkleur",
      "default": "#f4f4f4"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Kies Product"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Sfeerfoto (Optioneel)",
          "info": "Vervangt de productfoto in de collage."
        },
        {
          "type": "header",
          "content": "Parallax Instellingen"
        },
        {
          "type": "range",
          "id": "parallax_speed",
          "min": -0.5,
          "max": 0.5,
          "step": 0.1,
          "label": "Parallax Snelheid",
          "default": -0.1,
          "info": "Negatief = langzamer (diepte). Positief = sneller dan scroll."
        },
        {
          "type": "range",
          "id": "width",
          "min": 10,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Breedte Afbeelding",
          "default": 40
        },
        {
          "type": "range",
          "id": "vertical_offset",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Verticale Startpositie (Top)",
          "default": 10
        },
        {
          "type": "select",
          "id": "horizontal_align",
          "label": "Horizontale Positie",
          "options": [
            {"value": "flex-start", "label": "Links"},
            {"value": "center", "label": "Midden"},
            {"value": "flex-end", "label": "Rechts"}
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GV Parallax Stack",
      "blocks": [
        {"type": "product_card", "settings": {"parallax_speed": -0.2, "vertical_offset": 10, "horizontal_align": "flex-start"}},
        {"type": "product_card", "settings": {"parallax_speed": 0.1, "vertical_offset": 40, "horizontal_align": "flex-end"}},
        {"type": "product_card", "settings": {"parallax_speed": -0.1, "vertical_offset": 70, "horizontal_align": "center"}}
      ]
    }
  ]
}
{% endschema %}

<div class="gv-scroll-container" style="background-color: {{ section.settings.bg_color }}; height: {{ section.settings.section_height }}vh;">
  
  <div class="gv-parallax-wrapper">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      {% if product != blank %}
        
        {% comment %} Kies de juiste afbeelding {% endcomment %}
        {% assign image_to_show = product.featured_image %}
        {% if block.settings.custom_image != blank %}
          {% assign image_to_show = block.settings.custom_image %}
        {% endif %}

        <div class="gv-parallax-item" 
             style="
                width: {{ block.settings.width }}%; 
                top: {{ block.settings.vertical_offset }}%;
                justify-content: {{ block.settings.horizontal_align }};
             "
             data-scroll-speed="{{ block.settings.parallax_speed }}"
             data-block-id="{{ block.id }}">
          
          <div class="gv-image-card" onclick="openGVModal('{{ block.id }}')">
            <img src="{{ image_to_show | image_url: width: 1200 }}" 
                 alt="{{ image_to_show.alt }}" 
                 loading="lazy"
                 width="{{ image_to_show.width }}"
                 height="{{ image_to_show.height }}">
            
            <div class="gv-hover-overlay">
              <span>Shop {{ product.title }}</span>
            </div>
          </div>

          <script type="application/json" id="data-{{ block.id }}">
            {
              "id": {{ product.selected_or_first_available_variant.id }},
              "title": {{ product.title | json }},
              "price": {{ product.price | money | json }},
              "description": {{ product.description | strip_html | truncatewords: 30 | json }},
              "image": {{ product.featured_image | image_url: width: 800 | json }},
              "url": {{ product.url | json }},
              "available": {{ product.available | json }}
            }
          </script>

        </div>
      {% endif %}
    {% endfor %}
  </div>

</div>

<div id="GV-QuickShop-Modal" class="gv-modal-overlay" onclick="closeGVModal()">
  <div class="gv-modal-content" onclick="event.stopPropagation()">
    <button class="gv-close-btn" onclick="closeGVModal()">&times;</button>
    
    <div class="gv-modal-grid">
      <div class="gv-modal-image">
        <img id="gv-modal-img" src="" alt="">
      </div>
      <div class="gv-modal-info">
        <h3 id="gv-modal-title"></h3>
        <p id="gv-modal-price"></p>
        <p id="gv-modal-desc"></p>
        
        <button id="gv-atc-btn" class="gv-atc-button" onclick="addToCartGV()">Add to Bag</button>
        <a id="gv-full-link" href="#" class="gv-view-full">View Full Details</a>
      </div>
    </div>
  </div>
</div>

<style>
  /* --- LAYOUT & PARALLAX --- */
  .gv-scroll-container {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .gv-parallax-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 1600px;
    margin: 0 auto;
  }

  .gv-parallax-item {
    position: absolute;
    display: flex;
    will-change: transform; /* Performance optimalisatie */
    padding: 20px;
    z-index: 1;
  }

  .gv-image-card {
    position: relative;
    cursor: pointer;
    transition: transform 0.4s ease;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }

  .gv-image-card:hover {
    transform: scale(1.02);
    z-index: 10;
  }

  .gv-image-card img {
    width: 100%;
    height: auto;
    display: block;
  }

  .gv-hover-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.2);
    opacity: 0;
    transition: opacity 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .gv-image-card:hover .gv-hover-overlay {
    opacity: 1;
  }

  /* --- MODAL --- */
  .gv-modal-overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.3);
    backdrop-filter: blur(5px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s;
  }

  .gv-modal-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .gv-modal-content {
    background: #fff;
    width: 90%; max-width: 900px;
    height: 70vh;
    display: flex;
    position: relative;
    box-shadow: 0 20px 50px rgba(0,0,0,0.2);
  }

  .gv-close-btn {
    position: absolute; top: 10px; right: 20px;
    background: none; border: none; font-size: 30px; cursor: pointer; z-index: 10;
  }

  .gv-modal-grid { display: flex; width: 100%; height: 100%; }
  
  .gv-modal-image { width: 50%; background: #f4f4f4; display: flex; align-items: center; justify-content: center; }
  .gv-modal-image img { max-width: 100%; max-height: 100%; object-fit: contain; }

  .gv-modal-info { width: 50%; padding: 40px; display: flex; flex-direction: column; justify-content: center; }
  
  #gv-modal-title { font-size: 1.8rem; margin-bottom: 10px; font-family: var(--font-heading-family); }
  #gv-modal-price { font-size: 1.2rem; color: #666; margin-bottom: 20px; }
  #gv-atc-button { margin-top: 20px; }

  .gv-atc-button {
    width: 100%; background: #000; color: #fff; padding: 15px;
    border: none; text-transform: uppercase; cursor: pointer;
    font-weight: bold; transition: background 0.3s;
  }
  .gv-atc-button:hover { background: #333; }
  .gv-atc-button:disabled { background: #ccc; cursor: not-allowed; }

  @media (max-width: 768px) {
    .gv-modal-content { flex-direction: column; height: 90vh; }
    .gv-modal-grid { flex-direction: column; }
    .gv-modal-image, .gv-modal-info { width: 100%; height: 50%; }
    .gv-modal-info { padding: 20px; }
  }
</style>

<script>
  let currentVariantId = null;

  // 1. DE PARALLAX ENGINE (Objects With Narratives Logic)
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.gv-parallax-item');
    const container = document.querySelector('.gv-scroll-container');
    
    function animate() {
      const scrollY = window.scrollY;
      const windowHeight = window.innerHeight;
      
      items.forEach(item => {
        const speed = parseFloat(item.dataset.scrollSpeed) || 0;
        const rect = item.getBoundingClientRect();
        
        // Is het item in de buurt van de viewport?
        if (rect.top < windowHeight * 1.5 && rect.bottom > -windowHeight * 0.5) {
          // De Formule: Bereken verplaatsing t.o.v. scroll
          // We gebruiken de container offset als referentiepunt
          const containerTop = container.getBoundingClientRect().top + scrollY;
          const itemTop = item.offsetTop + containerTop;
          
          const yPos = (scrollY - itemTop + (windowHeight / 2)) * speed;
          
          item.style.transform = `translateY(${yPos}px)`;
        }
      });
      
      requestAnimationFrame(animate);
    }
    
    requestAnimationFrame(animate);
  });

  // 2. MODAL LOGIC
  const modal = document.getElementById('GV-QuickShop-Modal');
  const atcBtn = document.getElementById('gv-atc-btn');

  function openGVModal(blockId) {
    const dataScript = document.getElementById(`data-${blockId}`);
    if(!dataScript) return;
    
    const data = JSON.parse(dataScript.textContent);
    
    // Vul data
    document.getElementById('gv-modal-img').src = data.image;
    document.getElementById('gv-modal-title').innerText = data.title;
    document.getElementById('gv-modal-price').innerText = data.price;
    document.getElementById('gv-modal-desc').innerText = data.description;
    document.getElementById('gv-full-link').href = data.url;
    
    currentVariantId = data.id;
    
    // Check voorraad
    if(data.available) {
      atcBtn.innerText = "Add to Bag";
      atcBtn.disabled = false;
    } else {
      atcBtn.innerText = "Sold Out";
      atcBtn.disabled = true;
    }

    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeGVModal() {
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  // 3. ADD TO CART & DRAWER TRIGGER (JW Anderson Style)
  function addToCartGV() {
    if(!currentVariantId) return;

    atcBtn.innerText = "Adding...";
    
    const formData = {
      'items': [{
        'id': currentVariantId,
        'quantity': 1
      }]
    };

    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(formData)
    })
    .then(response => response.json())
    .then(data => {
      // Succes!
      atcBtn.innerText = "Added";
      
      // Wacht heel even en sluit dan de modal
      setTimeout(() => {
        closeGVModal();
        
        // TRIGGER DE CART DRAWER
        // We vuren alle bekende events af voor maximale compatibiliteit
        document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, cancelable: true }));
        document.documentElement.dispatchEvent(new CustomEvent('cart:open', { bubbles: true, cancelable: true }));
        document.documentElement.dispatchEvent(new CustomEvent('ajaxProduct:added', { bubbles: true, cancelable: true }));
        
        // Voor specifieke thema's (zoals Prestige / Dawn)
        const cartDrawer = document.querySelector('cart-drawer');
        if(cartDrawer) cartDrawer.open();

      }, 500);
    })
    .catch((error) => {
      console.error('Error:', error);
      atcBtn.innerText = "Error";
    });
  }
</script>