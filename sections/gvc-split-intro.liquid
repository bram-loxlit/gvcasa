{% comment %}
GVC Split Intro
Left column: Title + Subtitle
Right column: Paragraph copy
Use directly under a hero to recreate the NEW design
{% endcomment %}

<section class="gvc-split-intro" role="region" aria-label="{{ section.settings.heading | escape }}">
  <div class="gvc-split-intro__inner"
       style="
        --pt: {{ section.settings.padding_top }}px;
        --pb: {{ section.settings.padding_bottom }}px;
        --bg: {{ section.settings.background_color }};
        --tc: {{ section.settings.text_color }};
        --max-w: {% case section.settings.max_width %}{% when 'narrow' %}980px{% when 'medium' %}1140px{% else %}1320px{% endcase %};
        --gap: {{ section.settings.gap }}px;">
    <div class="gvc-split-intro__container">
      <div class="gvc-split-intro__left">
        {% if section.settings.heading != blank %}
          <h1 class="gvc-split-intro__heading{% if section.settings.heading_size == 'large' %} is-large{% endif %}">
            {{ section.settings.heading | escape }}
          </h1>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <div class="gvc-split-intro__subheading">
            {{ section.settings.subheading | escape }}
          </div>
        {% endif %}
      </div>

      <div class="gvc-split-intro__right">
        {% if section.settings.text != blank %}
          <div class="gvc-split-intro__text rte">
            {{ section.settings.text }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .gvc-split-intro {
    background: var(--bg, transparent);
    color: var(--tc, inherit);
  }
  .gvc-split-intro__inner {
    padding-top: var(--pt, 64px);
    padding-bottom: var(--pb, 64px);
    display: flex;
    justify-content: center;
  }
  .gvc-split-intro__container {
    width: 100%;
    max-width: var(--max-w, 1140px);
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap, 40px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .gvc-split-intro__container {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .gvc-split-intro__left,
    .gvc-split-intro__right {
      text-align: left;
    }
  }

  .gvc-split-intro__heading {
    margin: 0 0 8px 0;
    line-height: 1.08;
    letter-spacing: 0;
  }
  .gvc-split-intro__heading.is-large { font-size: clamp(36px, 6vw, 64px); }
  .gvc-split-intro__heading:not(.is-large) { font-size: clamp(28px, 4vw, 44px); }

  .gvc-split-intro__subheading {
    font-size: clamp(16px, 1.9vw, 20px);
    line-height: 1.5;
    opacity: 0.9;
  }
  .gvc-split-intro__text {
    font-size: clamp(14px, 1.6vw, 16px);
    line-height: 1.75;
    max-width: 64ch;
  }
  .gvc-split-intro__text p:last-child { margin-bottom: 0; }
</style>

{% schema %}
{
  "name": "GVC Split Intro",
  "class": "section-gvc-split-intro",
  "settings": [
    { "type": "text", "id": "heading", "label": "Title", "default": "Flair" },
    { "type": "text", "id": "subheading", "label": "Subtitle", "default": "Gert Voorjans for Jim Thompson" },
    { "type": "richtext", "id": "text", "label": "Body copy", "default": "<p>Write a short introduction here</p>" },

    { "type": "select", "id": "heading_size", "label": "Title size", "options": [
      { "value": "default", "label": "Default" },
      { "value": "large", "label": "Large" }
    ], "default": "large" },

    { "type": "select", "id": "max_width", "label": "Content width", "options": [
      { "value": "narrow", "label": "Narrow" },
      { "value": "medium", "label": "Medium" },
      { "value": "wide", "label": "Wide" }
    ], "default": "medium" },

    { "type": "range", "id": "gap", "label": "Column gap", "min": 12, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" }
  ],
  "presets": [
    {
      "name": "Split Intro",
      "category": "GV CASA"
    }
  ]
}
{% endschema %}
