{% comment %}
  GV CASA footer — NEW
  - Legal bar above the wordmark
  - Full-bleed wordmark
  - Refined, centered columns in a light block
  - Contact column powered by a menu
  - Mobile-first, tidy and readable
{% endcomment %}

<section class="gvc-footer" role="contentinfo">
  {%- for block in section.blocks -%}
    {%- if block.type == 'email-signup' -%}
      {% render block %}
    {%- endif -%}
  {%- endfor -%}

  <!-- LEGAL BAR (left: ©, right: legal links) -->
  <div class="gvc-legal" aria-label="Site legal links">
    <div class="gvc-legal-left">© {{ 'now' | date: "%Y" }} Gert Voorjans</div>
    <div class="gvc-legal-right">
      {%- assign legal = section.settings.legal_menu -%}
      {%- if legal and linklists[legal] and linklists[legal].links.size > 0 -%}
        {%- for link in linklists[legal].links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>{% unless forloop.last %} – {% endunless %}
        {%- endfor -%}
      {%- else -%}
        <a href="/pages/terms-and-conditions">Terms &amp; Conditions</a> - 
        <a href="/pages/privacy-policy">Privacy Policy</a> - 
        159451
<a href="/pages/return-policy">Return Policy</a>

      {%- endif -%}
    </div>
  </div>

  <!-- WORDMARK (full-bleed) -->
  <div class="gvc-wordmark-wrap">
    <div class="gvc-wordmark-inner">
      {% render 'gv-casa-wordmark', full_bleed: true %}
    </div>
  </div>

  <!-- COLUMNS (centered container inside light block) -->
  <div class="gvc-columns">
    <div class="gvc-container">
      <div class="gvc-grid">
        <div class="gvc-col">
          <h3 class="gvc-h">Gert Voorjans</h3>
          <div class="gvc-address">
            <p>
              <strong>Gert Voorjans HQ</strong><br>
              {{ section.settings.gvc_address_hq | newline_to_br }}
            </p>
            <p>
              <strong>Gert Voorjans ASIA</strong><br>
              {{ section.settings.gvc_address_asia | newline_to_br }}
            </p>
          </div>
        </div>

        <div class="gvc-col">
          <h3 class="gvc-h">Products</h3>
          <ul class="gvc-list">
            {%- for c in collections -%}
              {%- assign mf_products = c.metafields.footer.products -%}
              {%- if c.all_products_count > 0 and mf_products and mf_products.value -%}
                <li><a href="{{ c.url }}">{{ c.title }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        <div class="gvc-col">
          <h3 class="gvc-h">Collections</h3>
          <ul class="gvc-list">
            {%- for c in collections -%}
              {%- assign mf_show = c.metafields.footer.show -%}
              {%- if c.all_products_count > 0 and mf_show and mf_show.value -%}
                <li><a href="{{ c.url }}">{{ c.title }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        <div class="gvc-col">
          <h3 class="gvc-h">Contact</h3>
          <ul class="gvc-list">
            {%- assign contact = section.settings.contact_menu | default: 'contact' -%}
            {%- if contact and linklists[contact] and linklists[contact].links.size > 0 -%}
              {%- for link in linklists[contact].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              <li style="opacity:.7;">Assign a “contact” menu (Navigation)</li>
            {%- endif -%}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* ---------------- CORE TOKENS ---------------- */
    .gvc-footer { --container: min(1200px, 92vw); --ink: #111; --muted: rgba(0,0,0,.68) }

    /* ---------------- LEGAL BAR ---------------- */
    .gvc-legal {
      display: flex; justify-content: space-between; align-items: center;
      padding: 0 clamp(12px, 3vw, 28px);
      margin: 2rem 0 .5rem;
      font-size: clamp(13px, .9vw, 15px);
      color: var(--muted);
      line-height: 1.35;
    }
    .gvc-legal a { color: inherit; text-decoration: none }
    .gvc-legal a:hover { text-decoration: underline }

    /* ---------------- WORDMARK ---------------- */
    .gvc-wordmark-wrap { --edge: clamp(8px, 2.5vw, 16px); margin: 0 }
    .gvc-wordmark-inner {
      position: relative; left: 50%;
      width: calc(100vw - var(--edge) * 2);
      margin-left: calc(-50vw + var(--edge));
      line-height: 0;
    }
    .gvc-wordmark-wrap svg { display: block; width: 100%; height: auto }

    /* ---------------- COLUMNS BLOCK ---------------- */
    .gvc-columns {
      background: #f3f3f3;
      border-top: 1px solid rgba(0,0,0,.06);
      padding: clamp(24px, 3.2vw, 40px) 0 clamp(34px, 4vw, 54px);
    }
    .gvc-container { width: var(--container); margin-inline: auto }
    .gvc-grid {
      display: grid; gap: clamp(20px, 3vw, 38px);
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    /* ---------------- TYPOGRAPHY ---------------- */
    .gvc-h {
      font-size: clamp(13px, .95vw, 16px);
      font-weight: 500;
      letter-spacing: .06em;
      text-transform: uppercase;
      margin: 0 0 .75rem 0;
      color: var(--ink);
    }
    .gvc-list, .gvc-address {
      font-size: clamp(13px, .95vw, 15px);
      line-height: 1.6;
      color: var(--muted);
      margin: 0; padding: 0;
    }
    .gvc-list { list-style: none }
    .gvc-list li + li { margin-top: .45rem }
    .gvc-list a { color: var(--muted); text-decoration: none }
    .gvc-list a:hover { color: var(--ink); text-decoration: underline }
    .gvc-address p { margin: 0 0 .85rem 0; word-break: break-word; hyphens: auto }

    /* Hide any default theme bottom bars */
    .footer__content-bottom, .site-footer__bottom, .footer__bottom, .global-footer__copyright { display: none !important }

    /* ---------------- RESPONSIVE ---------------- */
    @media (max-width: 1000px) {
      .gvc-grid { grid-template-columns: repeat(2, minmax(0,1fr)) }
    }
    @media (max-width: 640px) {
      .gvc-legal {
        flex-direction: column; gap: .25rem; text-align: center;
        padding: 0 clamp(10px, 4vw, 18px); margin-top: 1.25rem;
      }
      .gvc-legal a { display: inline-block; padding: 4px 6px } /* comfortable tap */
      .gvc-grid { grid-template-columns: 1fr; gap: 18px }
      .gvc-columns { padding: 18px 0 28px }
      .gvc-h { margin-bottom: .55rem }
      .gvc-list li + li { margin-top: .35rem }
      .gvc-address p { margin-bottom: .65rem }
      .gvc-wordmark-wrap { --edge: clamp(8px, 3.5vw, 14px) }
    }
    @media (max-width: 360px) {
      .gvc-legal { font-size: 12.5px }
      .gvc-list, .gvc-address { font-size: 13px }
    }
  </style>
</section>

{% schema %}
{
  "name": "GV CASA Footer",
  "settings": [
    { "type": "link_list", "id": "legal_menu", "label": "Legal links menu" },
    { "type": "link_list", "id": "contact_menu", "label": "Contact column menu" },
    { "type": "textarea", "id": "gvc_address_hq", "label": "HQ address", "default": "Leopoldplaats 11, 2000 Antwerp, Belgium" },
    { "type": "textarea", "id": "gvc_address_asia", "label": "ASIA address", "default": "Unit E, 11/F, Maxgrand Plaza\\nNo. 3 Tai Yau Street, San Po Kong, Kowloon\\nHong Kong" }
  ],
  "blocks": [
    { "type": "email-signup", "name": "Email signup" }
  ],
  "presets": [
    { "name": "GV CASA Footer" }
  ]
}
{% endschema %}
